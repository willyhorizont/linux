{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "color": {
            // #00ADD8 -> RGB(0, 173, 216)
            // "title": "38;2;0;173;216",
            "title": "#00ADD8",
            // #FF1493 -> RGB(255, 20, 147)
            // "keys": "38;2;255;20;147",
            "keys": "#FF1493",
            // #CCFF00 -> RGB(204, 255, 0)
            // "output": "38;2;204;255;0",
            "output": "#CCFF00",
        }
    },
    "modules": [
        "title",
        "separator",

        {
            "key": "Name",
            "type": "host",
            // !!! customize here !!!
            "format": "(2012) Lenovo ThinkPad T430s i7 non-Nvidia",
            // "format": "(2021) Lenovo ThinkPad T14 Gen 2 AMD 5850U 16GB Soldered RAM",
        },

        // !!! customize here !!!
        {
            "key": "CPU",
            "type": "cpu",
            "format": "Intel Core i7-3520M, 3th Gen \"Ivy Bridge-M\", 22nm",
            // "format": "AMD Ryzen 7 5850U, Zen 3 / GCN5 based \"Cezanne-U\", TSMC 7nm",
        },
        {
            "key": " ",
            "type": "cpu",
            "format": "     2.9 — 3.6GHz, 2 Cores, 4 Threads, 4MB Cache, 35W TDP",
            // "format": "     1.9 – 4.4GHz, 8 Cores, 16 Threads, 20MB Cache, 15W TDP",
        },

        // !!! customize here !!!
        {
            "key": "GPU Integrated",
            "type": "gpu",
            "format": "Intel HD Graphics 4000",
            // "format": "AMD Radeon Vega 8",
        },
        {
            "key": "GPU Dedicated",
            "type": "custom",
            "format": "None"
        },

        // !!! customize here !!!
        {
            "key": "RAM",
            "type": "custom",
            "format": "16GB DDR3-1600 (8GB SO-DIMM + 8GB SO-DIMM)",
            // "format": "32GB DDR4-3200 (16GB Soldered + 16GB SO-DIMM)",
        },

        // !!! customize here !!!
        {
            "key": "Storage",
            "type": "custom",
            "format": "256GB SSD 2.5inch SATA",
            // "format": "1TB SSD M.2 2280 PCIe NVMe",
        },

        // !!! customize here !!!
        {
            "key": "OS",
            "type": "custom",
            "format": "LMDE (Linux Mint Debian Edition) Cinnamon",
            // "format": "Fedora Linux KDE Plasma",
        },

        {
            "key": "Distro",
            "type": "os"
        },

        {
            "key": "Desktop Environment",
            "type": "de"
        },

        "kernel",
        "shell",

        {
            "key": "Swap Partition",
            "type": "swap",
            "format": "{2}"
        },

        {
            "key": "Boot Manager",
            "type": "bootmgr",
            "format": "{1}"
        },

        "initsystem",

        {
            "key": "Login Manager / Display Manager",
            "type": "lm"
        },

        {
            "key": "Window Manager",
            "type": "wm"
        },

        {
            "key": "Terminal Emulator",
            "type": "terminal"
        },

        {
            "type": "custom",
            "key": " ",
            // "format": "{#38;2;241;224;90}███{#}{#38;2;49;120;198}███{#}{#38;2;53;114;165}███{#}{#38;2;79;93;149}███{#}{#38;2;0;173;216}███{#}{#38;2;2;152;195}███{#}{#38;2;162;112;186}███{#}{#38;2;0;0;128}███{#}{#38;2;112;21;22}███{#}{#38;2;25;140;231}███{#}{#38;2;169;123;255}███{#}{#38;2;240;81;56}███{#}{#38;2;0;180;171}███{#}{#38;2;148;93;183}███{#}{#38;2;23;134;0}███{#}{#38;2;225;103;55}███{#}{#38;2;221;17;0}███{#}{#38;2;0;0;251}███{#}{#38;2;194;45;64}███{#}",
            "format": "{##F1E05A}███{#}{##3572A5}███{#}{##4F5D95}███{#}{##00ADD8}███{#}{##0298C3}███{#}{##A270BA}███{#}{##000080}███{#}{##701516}███{#}{##198CE7}███{#}{##A97BFF}███{#}{##F05138}███{#}{##00B4AB}███{#}{##945DB7}███{#}{##178600}███{#}{##E16737}███{#}{##DD1100}███{#}{##0000FB}███{#}{##C22D40}███{#}{##B07219}███{#}",
        },
        {
            "type": "custom",
            "key": " ",
            // "format": "{#38;2;176;114;25}███{#}{#38;2;201;223;64}███{#}{#38;2;85;187;85}███{#}{#38;2;25;159;75}███{#}{#38;2;222;165;132}███{#}{#38;2;126;126;255}███{#}{#38;2;228;204;152}███{#}{#38;2;53;85;112}███{#}{#38;2;35;157;173}███{#}{#38;2;1;36;86}███{#}{#38;2;110;74;126}███{#}{#38;2;239;122;8}███{#}{#38;2;184;57;152}███{#}{#38;2;255;175;243}███{#}{#38;2;236;145;92}███{#}{#38;2;255;194;0}███{#}{#38;2;96;175;254}███{#}{#38;2;243;75;125}███{#}{#38;2;67;142;255}███{#}",
            "format": "{##C9DF40}███{#}{##55BB55}███{#}{##199F4B}███{#}{##DEA584}███{#}{##7E7EFF}███{#}{##E4CC98}███{#}{##355570}███{#}{##239DAD}███{#}{##012456}███{#}{##6E4A7E}███{#}{##EF7A08}███{#}{##B83998}███{#}{##FFAFF3}███{#}{##EC915C}███{#}{##FFC200}███{#}{##60AFFE}███{#}{##F34B7D}███{#}{##438EFF}███{#}{##596706}███{#}",
        },
        {
            "type": "custom",
            "key": " ",
            // "format": "{#38;2;89;103;6}███{#}{#38;2;136;43;15}███{#}{#38;2;66;152;184}███{#}{#38;2;0;134;139}███{#}{#38;2;37;99;235}███{#}{#38;2;85;85;85}███{#}{#38;2;186;89;94}███{#}{#38;2;79;135;196}███{#}{#38;2;165;109;226}███{#}{#38;2;0;1;0}███{#}{#38;2;56;56;56}███{#}{#38;2;0;83;144}███{#}"
            "format": "{##882B0F}███{#}{##4298B8}███{#}{##00868B}███{#}{##2563EB}███{#}{##555555}███{#}{##BA595E}███{#}{##4F87C4}███{#}{##A56DE2}███{#}{##000100}███{#}{##383838}███{#}{##005390}███{#}"
        }
    ]
}
